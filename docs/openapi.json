{
  "openapi": "3.1.0",
  "info": {
    "title": "Easy Generator authentication API",
    "version": "1.0.0",
    "description": "The authentication API behind the Easy Generator test task. All routes are under `/api`, every response sends `Cache-Control: no-store` and a server-generated `X-Request-Id`, and the request rules come from the same shared schemas that the browser and the server validate with.\n\n## Request controls\n\nEvery POST must send `Origin` exactly equal to the app's address, `X-CSRF-Protection: 1`, and an uncompressed `Content-Type: application/json` body of at most 16 KiB. Otherwise the handler never runs. CORS is disabled.\n\n\"Try it out\" on this page works because it is served from the same origin as the API. Desktop tools such as Postman or Insomnia work if they set `Origin` to the app's address. Browser-hosted tools on another origin cannot call this API, by design.\n\n## Sessions\n\nSignin issues an opaque 256-bit token in an `HttpOnly`, `SameSite=Lax`, `Path=/` cookie: `session` over local HTTP, and `__Host-session` with `Secure` in production. A session lasts exactly 24 hours from signin, with no renewal, and the server stores only a hash of the token. `GET /api/auth/me` never sets or clears cookies. Logout revokes only the presented session.\n\n## Errors\n\nEvery failure has the shape `{ \"error\": { \"code\", \"message\", \"fields\"?, \"requestId\" } }`. `fields` appears only for field validation errors. Messages never echo input. Unknown API routes return `404` with `NOT_FOUND`, never the web page.\n\n## Rate limits\n\nPer route and client IP: signup 5 per minute, signin 10 per minute, logout 30 per minute, and every other route 120 per minute. A `429` includes `Retry-After` in seconds. Counters live in memory and reset on restart."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Accounts and sessions"
    },
    {
      "name": "health",
      "description": "Readiness"
    }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "signup",
        "summary": "Create an account",
        "description": "Creates the account only; signup never starts a session.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfProtection"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              },
              "example": {
                "name": "Ada Lovelace",
                "email": "ada@example.com",
                "password": "Analytical-1"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The account was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                },
                "example": {
                  "user": {
                    "id": "6650f0c2a4b1c2d3e4f50607",
                    "email": "ada@example.com",
                    "name": "Ada Lovelace"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body failed validation; field errors are listed in `fields`: `VALIDATION_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing or wrong `Origin` or `X-CSRF-Protection`: `REQUEST_FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The email is already registered: `EMAIL_IN_USE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than the limit: `PAYLOAD_TOO_LARGE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Body is not uncompressed JSON: `UNSUPPORTED_MEDIA_TYPE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see `Retry-After`: `RATE_LIMITED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error: `INTERNAL_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable: `SERVICE_UNAVAILABLE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signin": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "signin",
        "summary": "Sign in and start a session",
        "description": "Verifies the credentials, then sets a new session cookie. An unknown email and a wrong password get the same error.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfProtection"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SigninRequest"
              },
              "example": {
                "email": "ada@example.com",
                "password": "Analytical-1"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "headers": {
              "Set-Cookie": {
                "description": "The new session cookie.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                },
                "example": {
                  "user": {
                    "id": "6650f0c2a4b1c2d3e4f50607",
                    "email": "ada@example.com",
                    "name": "Ada Lovelace"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body failed validation; field errors are listed in `fields`: `VALIDATION_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The email or password is incorrect: `INVALID_CREDENTIALS`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing or wrong `Origin` or `X-CSRF-Protection`: `REQUEST_FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than the limit: `PAYLOAD_TOO_LARGE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Body is not uncompressed JSON: `UNSUPPORTED_MEDIA_TYPE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see `Retry-After`: `RATE_LIMITED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error: `INTERNAL_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable: `SERVICE_UNAVAILABLE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getCurrentUser",
        "summary": "The signed-in user (the protected endpoint)",
        "description": "Requires a valid, unexpired session and returns only that session's owner.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The session owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                },
                "example": {
                  "user": {
                    "id": "6650f0c2a4b1c2d3e4f50607",
                    "email": "ada@example.com",
                    "name": "Ada Lovelace"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see `Retry-After`: `RATE_LIMITED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error: `INTERNAL_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable: `SERVICE_UNAVAILABLE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "summary": "Sign out",
        "description": "Revokes the presented session, if any, and expires the cookie only after the revocation is confirmed. Idempotent.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfProtection"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "204": {
            "description": "Signed out; the cookie is expired.",
            "headers": {
              "Set-Cookie": {
                "description": "The expired session cookie.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The body is not `{}`: `VALIDATION_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing or wrong `Origin` or `X-CSRF-Protection`: `REQUEST_FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than the limit: `PAYLOAD_TOO_LARGE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Body is not uncompressed JSON: `UNSUPPORTED_MEDIA_TYPE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see `Retry-After`: `RATE_LIMITED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error: `INTERNAL_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Revocation could not be confirmed; the cookie is kept: `SERVICE_UNAVAILABLE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "getHealth",
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "The API and the database are ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see `Retry-After`: `RATE_LIMITED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error: `INTERNAL_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Not ready. No infrastructure details are given.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "unavailable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Trimmed before validation. Lengths count Unicode code points."
          },
          "email": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "format": "email",
            "maxLength": 254,
            "description": "Trimmed and lowercased before validation; dots and `+` tags are kept."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "At least one letter, one decimal digit, and one punctuation or symbol character; whitespace is allowed but is not a special character. Never trimmed or normalized. Lengths count Unicode code points."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "SigninRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "format": "email",
            "maxLength": 254,
            "description": "Trimmed and lowercased before validation; dots and `+` tags are kept."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Any nonempty value. Composition rules apply only at signup, so a password that fails them gets the generic credential error."
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "INVALID_CREDENTIALS",
                  "UNAUTHENTICATED",
                  "REQUEST_FORBIDDEN",
                  "NOT_FOUND",
                  "EMAIL_IN_USE",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "RATE_LIMITED",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "CsrfProtection": {
        "name": "X-CSRF-Protection",
        "in": "header",
        "required": true,
        "description": "Required on every POST. The only accepted value is 1.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ],
          "default": "1"
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Set by signin and sent by the browser; scripts cannot read it. Named `__Host-session` in production."
      }
    }
  }
}
