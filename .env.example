NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
SERVE_WEB=false
TRUST_PROXY=false
# Discovery uses the same localhost:27018 endpoint inside Mongo and on the host.
MONGODB_URI=mongodb://localhost:27018/easy_generator?replicaSet=easy-generator-rs
# Tests generate their own databases from this dedicated marker URI.
MONGODB_TEST_URI=mongodb://localhost:27018/easy_generator_test?replicaSet=easy-generator-rs
